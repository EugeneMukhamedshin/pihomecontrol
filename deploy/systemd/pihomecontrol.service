[Unit]
Description=pihomecontrol: отопление, насос и бойлер (GPIO)
Documentation=file://__APP_DIR__/README.md
After=network-online.target
Wants=network-online.target
# pigpiod НЕ нужен и мешает: модуль pigpio инициализирует GPIO внутри процесса
# и падает с «pigpio error -1», если демон уже держит /var/run/pigpio.pid.
# Поэтому в зависимостях его нет, а на Pi он должен быть остановлен.

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__APP_DIR__
# Доступ к /dev/gpiochip* для onoff (насос, бойлер, реле котла).
SupplementaryGroups=gpio
# PORT, AUTH_PASSWORD, AUTH_SECRET и другие настройки — здесь.
EnvironmentFile=-__APP_DIR__/config/pihomecontrol.env
Environment=NODE_ENV=production
ExecStart=__NODE_BIN__ __APP_DIR__/homecontrol.js
Restart=always
RestartSec=3
# Даём приложению время погасить контакторы по SIGTERM.
TimeoutStopSec=15

# Порт 80 без запуска от root. Если PORT=8080, строки не нужны, но не мешают.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Система только для чтения; запись разрешена только в каталог приложения:
# там config.txt, state.json, auth.json, data/ и homecontrol.log.
ProtectSystem=strict
ReadWritePaths=__APP_DIR__
PrivateTmp=true

[Install]
WantedBy=multi-user.target
