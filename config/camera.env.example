# Настройки записи с камеры Tapo C320WS в Яндекс Диск.
#
# Скопируйте файл и заполните значения:
#   cp config/camera.env.example config/camera.env
#
# Формат строгий: ИМЯ=значение, без пробелов вокруг "=", комментарии — только
# отдельной строкой. Файл читается через source, поэтому запись вида
# "CAM_REMOTE=yadisk:cam  # куда лить" сломает значение.
# config/camera.env в git не попадает: в нём пароль от камеры.

# --- Камера ---------------------------------------------------------------
# Учётная запись камеры включается в приложении Tapo:
# Настройки → Дополнительные настройки → Учётная запись камеры.
# stream1 — 2K, stream2 — низкое качество (для узкого канала заливки).
# Если в пароле есть @ : / #, закодируйте их: @ → %40, : → %3A, / → %2F, # → %23.
CAM_RTSP_URL="rtsp://admin:CHANGE_ME@192.168.1.50:554/stream1"

# --- Локальный буфер ------------------------------------------------------
# Куда ffmpeg пишет сегменты. Не SD-карту с системой: лучше USB-диск,
# иначе карта умрёт от постоянной записи.
CAM_OUT_DIR=/mnt/usb/cam

# Длина сегмента в секундах: 300 = 5 минут. Один файл ≈ 0,5-1 ГБ при 2K.
CAM_SEGMENT_SECONDS=300

# Сколько секунд без новых данных считать зависанием и перезапускать ffmpeg.
CAM_STALL_SECONDS=600

# Не начинать запись, если на диске меньше стольких ГиБ свободно.
CAM_MIN_FREE_GB=2

# Звук: aac — перекодировать в AAC (mp4 примет такой звук всегда),
# copy — копировать как есть (быстрее, но mp4 не примет PCM/A-law),
# none — писать без звука.
CAM_AUDIO=aac

# Дополнительные флаги mp4. Пустое значение — обычный mp4.
# +frag_keyframe+empty_moov делает последний (оборванный) сегмент читаемым.
CAM_MOVFLAGS=+frag_keyframe+empty_moov

# --- Облако ---------------------------------------------------------------
# remote из rclone и папка на Диске. Проверка: rclone lsd yadisk:
CAM_REMOTE=yadisk:cam

# Заливать только сегменты старше этого возраста (rclone --min-age):
# свежий файл ещё дописывается, забирать его рано.
CAM_MIN_AGE=10m

# Пауза между проходами заливки, секунды.
CAM_UPLOAD_INTERVAL=120

# Хранить в облаке N дней. 0 — не удалять ничего.
# Через WebDAV удаление безвозвратное: корзины нет.
CAM_RETENTION_DAYS=14

# --- Служебное ------------------------------------------------------------
# Логи по умолчанию в data/. Меняйте только если знаете, зачем.
# CAM_LOG_DIR=/var/log/pihomecontrol
