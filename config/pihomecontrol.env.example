# Настройки сервиса pihomecontrol.
#
# Скопируйте этот файл в config/pihomecontrol.env (он в git не попадает):
#   cp config/pihomecontrol.env.example config/pihomecontrol.env
#   chmod 600 config/pihomecontrol.env
#
# Формат systemd EnvironmentFile: KEY=value, без пробелов вокруг "=".
# Значения с пробелами и решёткой берите в кавычки: AUTH_PASSWORD="мой пароль".

# Порт веб-интерфейса. 80 — как раньше; юнит даёт право слушать его без root.
PORT=80

# Порт метрик Prometheus.
METRICS_PORT=9000

# Пароль для входа. Если не задан, при первом запуске создаётся auth.json,
# а пароль печатается в лог: journalctl -u pihomecontrol | grep "Пароль создан".
# AUTH_PASSWORD=замените-меня

# Секрет подписи cookie. Если не задан, создаётся и хранится в auth.json.
# AUTH_SECRET=

# Ставить cookie только по HTTPS (когда впереди TLS-прокси).
# AUTH_COOKIE_SECURE=1

# Заглушка GPIO вместо железа — только для отладки на Pi без датчиков.
# GPIO_MOCK=1
